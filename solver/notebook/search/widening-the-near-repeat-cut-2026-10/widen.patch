--- /dev/null
+++ b/solver/frame/src/search/widen.rs
@@ -0,0 +1,493 @@
+//! A study's cut, built only with the feature `studies`: the near-repeat cut of docs/theory/ledger.md (Lemma R) and
+//! its widenings, against a reference problem Π_M, as the notebook entry
+//! solver/notebook/search/widening-the-near-repeat-cut-2026-10/ measures them.
+//!
+//! [`check`] decides at a node of a search of Π_N, with the promotions P and the candidates C, whether every
+//! completion of the node that is a promotion set of Π_N is one of Π_M.  The base check is Lemma R word for word.  The
+//! mode's bits widen it, each by a lemma of the entry:
+//!
+//! * [`STRIP`]: M's frame is first stripped of its *free* moves: a move with a factor that no other move of the frame
+//!   and no member of C pays for, and that is no member of C, goes with that factor (Lemma F of the entry: the frame
+//!   with any X ⊆ C applied is winnable with it iff without it);
+//! * [`RAW_N`], [`RAW_M`]: the frame of N, or of M, may also be taken as P leaves it before the reduction (the state
+//!   lemma holds for any prefix of the reduction's drops);
+//! * [`RENAME`]: where the identity fails, a renaming of the moves of M's frame that are no moves of N's, and of the
+//!   factors of N's frame that M's lacks (Lemma S of the entry);
+//! * [`DISMANTLE`]: M's movers, its moves and the candidates promoted into it, dismantled to the residual that every
+//!   unwinnable set lies in (Lemma C of the entry, by Theorems 4 and 5 of the decision procedure).
+//!
+//! The searcher calls [`cuts`] at each bound check when a reference is set ([`set_references`]); `tune` sets it from
+//! `TAXMAN_WIDEN_REF` and `TAXMAN_WIDEN_MODE`.
+
+use crate::bits::Bits;
+use crate::model::{Frame, FrameGraph, FrameSet, Scratch};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, OnceLock};
+
+/// Mode bit: strip M's free moves.
+pub const STRIP: u32 = 1;
+/// Mode bit: also try N's frame before the reduction.
+pub const RAW_N: u32 = 2;
+/// Mode bit: also try M's frame before the reduction.
+pub const RAW_M: u32 = 4;
+/// Mode bit: a renaming where the identity fails.
+pub const RENAME: u32 = 8;
+/// Mode bit: M's movers dismantled to their residual (Lemma C of the entry).
+pub const DISMANTLE: u32 = 16;
+
+/// Why the check fails, or [`HOLDS`].
+pub const HOLDS: usize = 0;
+/// A promotion is no candidate of M.
+pub const PROMOTED: usize = 1;
+/// A candidate is no candidate of M, or has another home there.
+pub const CANDS: usize = 2;
+/// The promotions cannot be promoted in M.
+pub const PROMOTE: usize = 3;
+/// A frame that C touches is missing in M.
+pub const FRAMES: usize = 4;
+/// A move of M's frame is no move of N's.
+pub const MOVES: usize = 5;
+/// A factor of N's frame that M's lacks is in C, or pays for a move of M's frame or a member of C.
+pub const FACTORS: usize = 6;
+/// The incumbent is below the reference's bound.
+pub const BOUND: usize = 7;
+/// The number of reasons.
+pub const REASONS: usize = 8;
+/// The reasons' names.
+pub const NAMES: [&str; REASONS] = ["holds", "promoted", "cands", "promote", "frames", "moves", "factors", "bound"];
+
+/// A reference problem Π_M, with a proven bound on its best promotion sum, set up beside Π_N.
+pub struct Reference<const W: usize> {
+    pub model: Arc<FrameGraph>,
+    pub root: FrameSet<W>,
+    /// A proven bound on P*(Π_M).
+    pub bound: u64,
+    /// The candidates of N that are candidates of M, and those of them with the same home in both.
+    pub marked: Bits<W>,
+    pub same_home: Bits<W>,
+    /// Per frame h of N, its candidates of home h.
+    pub home_of: Vec<Bits<W>>,
+}
+
+impl<const W: usize> Reference<W> {
+    /// The reference M (`model`, `root`, `cands_m`, `bound`) for a search of N (`model_n`, `cands_n`).  `None` if
+    /// either problem has one-sided candidates, which Lemma R does not treat.
+    pub fn new(
+        model: Arc<FrameGraph>,
+        root: FrameSet<W>,
+        cands_m: &Bits<W>,
+        bound: u64,
+        model_n: &FrameGraph,
+        cands_n: &Bits<W>,
+        frames_n: usize,
+    ) -> Option<Self> {
+        if model.has_one_sided() || model_n.has_one_sided() {
+            return None;
+        }
+        let marked = *cands_n & *cands_m;
+        let same_home: Bits<W> = marked.iter().filter(|&x| model.home(x) == model_n.home(x)).collect();
+        let mut home_of = vec![Bits::EMPTY; frames_n + 1];
+        for x in cands_n.iter() {
+            home_of[model_n.home(x)].insert(x);
+        }
+        Some(Reference { model, root, bound, marked, same_home, home_of })
+    }
+}
+
+/// The frames of a state before the reduction: `root` with `promoted` applied (`None` if some member has no home
+/// factor there).
+fn raw<const W: usize>(model: &FrameGraph, root: &FrameSet<W>, promoted: &Bits<W>) -> Option<Vec<Frame<W>>> {
+    let (edits, None) = model.edits(root, promoted) else { return None };
+    Some(
+        root.frames()
+            .iter()
+            .enumerate()
+            .map(|(j, f)| Frame { moves: f.moves | edits.gained[j], factors: f.factors - edits.lost[j], freedoms: 0 })
+            .collect(),
+    )
+}
+
+/// M's frame stripped of its free moves (see the module docs): repeatedly, a move with a factor that no other move
+/// and no member of `c_in` pays for, and that is not in `cands`, is dropped with that factor.
+fn strip<const W: usize>(model: &FrameGraph, frame: &Frame<W>, cands: &Bits<W>, c_in: &Bits<W>) -> Frame<W> {
+    let g = model.graph();
+    let (mut moves, mut factors) = (frame.moves, frame.factors);
+    loop {
+        let mut dropped = false;
+        let before = moves;
+        for a in before.iter() {
+            let private = g.factors(a).iter().map(|&q| u32::from(q)).find(|&q| {
+                factors.contains(q)
+                    && !cands.contains(q)
+                    && g.composites(q).iter().all(|&z| {
+                        let z = u32::from(z);
+                        z == a || (!moves.contains(z) && !c_in.contains(z))
+                    })
+            });
+            if let Some(q) = private {
+                moves.remove(a);
+                factors.remove(q);
+                dropped = true;
+            }
+        }
+        if !dropped {
+            return Frame { moves, factors, freedoms: 0 };
+        }
+    }
+}
+
+/// Condition 3 of Lemma R on one frame: M's moves within N's, and every factor of N's that M's lacks in no member of
+/// C and paying for no move of M's and no member of `c_in`.  `Err` the reason and the numbers that break it.
+fn compare<const W: usize>(
+    graph_n: &FrameGraph,
+    m: &Frame<W>,
+    n: &Frame<W>,
+    cands: &Bits<W>,
+    c_in: &Bits<W>,
+) -> Result<(), (usize, Bits<W>)> {
+    if !m.moves.is_subset(&n.moves) {
+        return Err((MOVES, m.moves - n.moves));
+    }
+    let g = graph_n.graph();
+    let bad: Bits<W> = (n.factors - m.factors)
+        .iter()
+        .filter(|&y| {
+            cands.contains(y)
+                || g.composites(y).iter().any(|&z| m.moves.contains(u32::from(z)) || c_in.contains(u32::from(z)))
+        })
+        .collect();
+    if bad.is_empty() {
+        Ok(())
+    } else {
+        Err((FACTORS, bad))
+    }
+}
+
+/// The residual of M's movers on one frame (Lemma C of the entry): its moves and the members of C promoted into it
+/// (`c_in`), from which a mover is dropped, again and again, while it pays with a factor of the frame that is not in C
+/// and that no other mover left pays with.  Every self-covering set of movers, under any X ⊆ C, lies in the residual.
+pub fn dismantle<const W: usize>(model: &FrameGraph, m: &Frame<W>, cands: &Bits<W>, c_in: &Bits<W>) -> Bits<W> {
+    let g = model.graph();
+    let mut movers = m.moves | *c_in;
+    let witnesses = m.factors - *cands;
+    let mut count = vec![0u16; Bits::<W>::CAPACITY as usize];
+    for q in witnesses.iter() {
+        count[q as usize] = g.composites(q).iter().filter(|&&z| movers.contains(u32::from(z))).count() as u16;
+    }
+    let mut work: Vec<u32> = movers.to_vec();
+    while let Some(x) = work.pop() {
+        if !movers.contains(x) {
+            continue;
+        }
+        let private = g.factors(x).iter().any(|&q| witnesses.contains(u32::from(q)) && count[usize::from(q)] == 1);
+        if !private {
+            continue;
+        }
+        movers.remove(x);
+        for &q in g.factors(x) {
+            let q32 = u32::from(q);
+            if !witnesses.contains(q32) {
+                continue;
+            }
+            count[usize::from(q)] -= 1;
+            if count[usize::from(q)] == 1 {
+                if let Some(&z) = g.composites(q32).iter().find(|&&z| movers.contains(u32::from(z))) {
+                    work.push(u32::from(z));
+                }
+            }
+        }
+    }
+    movers
+}
+
+/// Lemma C on one frame: the moves of M's frame in the residual `residual` are moves of N's, and every factor of N's
+/// frame that M's lacks is in no member of C and pays for no mover of the residual.
+fn compare_core<const W: usize>(
+    graph_n: &FrameGraph,
+    m: &Frame<W>,
+    n: &Frame<W>,
+    cands: &Bits<W>,
+    residual: &Bits<W>,
+) -> Result<(), (usize, Bits<W>)> {
+    let kept = m.moves & *residual;
+    if !kept.is_subset(&n.moves) {
+        return Err((MOVES, kept - n.moves));
+    }
+    let g = graph_n.graph();
+    let bad: Bits<W> = (n.factors - m.factors)
+        .iter()
+        .filter(|&y| cands.contains(y) || g.composites(y).iter().any(|&z| residual.contains(u32::from(z))))
+        .collect();
+    if bad.is_empty() {
+        Ok(())
+    } else {
+        Err((FACTORS, bad))
+    }
+}
+
+/// Lemma S on one frame: a renaming φ of the moves of M's frame that are no moves of N's onto moves of N's frame that
+/// are no moves of M's (φ the identity on the other moves and on the members of C), and ρ from the factors of N's frame
+/// that the images pay with to factors of M's frame, injective, such that every mover a of M's frame (a move, or a
+/// member of C of home j + 1) pays with ρ(q) iff φ(a) pays with q, ρ the identity on the members of C and sending no
+/// other factor into C, and every member of C among N's factors a factor of M's.  Found by trying the renamings of
+/// the unmatched moves in turn (the gadgets of a near repeat have one to three moves).
+fn rename<const W: usize>(
+    graph_m: &FrameGraph,
+    graph_n: &FrameGraph,
+    m: &Frame<W>,
+    n: &Frame<W>,
+    cands: &Bits<W>,
+    c_in: &Bits<W>,
+) -> bool {
+    if !(n.factors & *cands).is_subset(&m.factors) {
+        return false;
+    }
+    let from: Vec<u32> = (m.moves - n.moves).to_vec();
+    let to: Vec<u32> = (n.moves - m.moves).to_vec();
+    if from.len() > 3 || to.len() < from.len() || to.len() > 6 {
+        return false;
+    }
+    let movers: Vec<u32> = (m.moves | *c_in).to_vec();
+    let mut phi = vec![0u32; from.len()];
+    let mut used = vec![false; to.len()];
+    let ctx = Renaming { graph_m, graph_n, m, n, cands, from: &from, to: &to, movers: &movers };
+    ctx.search(&mut phi, &mut used, 0)
+}
+
+struct Renaming<'a, const W: usize> {
+    graph_m: &'a FrameGraph,
+    graph_n: &'a FrameGraph,
+    m: &'a Frame<W>,
+    n: &'a Frame<W>,
+    cands: &'a Bits<W>,
+    from: &'a [u32],
+    to: &'a [u32],
+    movers: &'a [u32],
+}
+
+impl<const W: usize> Renaming<'_, W> {
+    fn search(&self, phi: &mut [u32], used: &mut [bool], k: usize) -> bool {
+        if k == self.from.len() {
+            return self.holds(phi);
+        }
+        for i in 0..self.to.len() {
+            if !used[i] {
+                used[i] = true;
+                phi[k] = self.to[i];
+                if self.search(phi, used, k + 1) {
+                    return true;
+                }
+                used[i] = false;
+            }
+        }
+        false
+    }
+
+    /// Whether the renaming `from[i] -> phi[i]` extends to a ρ that Lemma S accepts.  For each factor q of N's frame
+    /// that an image pays with, the set of movers whose images pay with q must be the set of movers that pay with
+    /// ρ(q) in M's frame: ρ(q) = q where that holds (and must, for q in C), else another factor of M's frame, not in C
+    /// and not yet used.
+    fn holds(&self, phi: &[u32]) -> bool {
+        let (gm, gn) = (self.graph_m.graph(), self.graph_n.graph());
+        let image = |a: u32| self.from.iter().position(|&x| x == a).map_or(a, |i| phi[i]);
+        let mut pairs: Vec<(u32, u32)> = Vec::new(); // (q, a): the image of mover a pays with q
+        for &a in self.movers {
+            for &q in gn.factors(image(a)) {
+                let q = u32::from(q);
+                if self.n.factors.contains(q) {
+                    pairs.push((q, a));
+                }
+            }
+        }
+        pairs.sort_unstable();
+        let payers_m = |r: u32| -> Vec<u32> {
+            let mut v: Vec<u32> = gm
+                .composites(r)
+                .iter()
+                .map(|&z| u32::from(z))
+                .filter(|&z| self.movers.binary_search(&z).is_ok())
+                .collect();
+            v.sort_unstable();
+            v
+        };
+        let mut taken: Vec<u32> = Vec::new();
+        let mut i = 0;
+        while i < pairs.len() {
+            let q = pairs[i].0;
+            let mut want = Vec::new();
+            while i < pairs.len() && pairs[i].0 == q {
+                want.push(pairs[i].1);
+                i += 1;
+            }
+            let fits = |r: u32| self.m.factors.contains(r) && !taken.contains(&r) && payers_m(r) == want;
+            let target = if fits(q) {
+                Some(q)
+            } else if self.cands.contains(q) {
+                None
+            } else {
+                gm.factors(want[0]).iter().map(|&r| u32::from(r)).find(|&r| !self.cands.contains(r) && fits(r))
+            };
+            match target {
+                Some(r) => taken.push(r),
+                None => return false,
+            }
+        }
+        true
+    }
+}
+
+/// Lemma R (and with `mode`, its widenings) at a node of N's search: its state `state_n`, promotions `promoted` and
+/// candidates `cands`, against the reference `r`; `need_total` is what a completion must be worth to beat the
+/// incumbent (incumbent + 1).  [`HOLDS`] if every completion that is a promotion set of Π_N is one of Π_M, worth at
+/// most the reference's bound, which is below `need_total`; else the reason, and in `why` the numbers that break it.
+#[allow(clippy::too_many_arguments)]
+pub fn check<const W: usize>(
+    r: &Reference<W>,
+    model_n: &FrameGraph,
+    root_n: &FrameSet<W>,
+    state_n: &FrameSet<W>,
+    promoted: &Bits<W>,
+    cands: &Bits<W>,
+    need_total: u64,
+    mode: u32,
+    scratch: &mut Scratch<W>,
+    why: &mut Bits<W>,
+) -> usize {
+    if r.bound >= need_total {
+        return BOUND;
+    }
+    if !promoted.is_subset(&r.marked) {
+        *why = *promoted - r.marked;
+        return PROMOTED;
+    }
+    if !cands.is_subset(&r.same_home) {
+        *why = *cands - r.same_home;
+        return CANDS;
+    }
+    let Some(state_m) = r.model.promote_all_using(scratch, &r.root, promoted) else {
+        return PROMOTE;
+    };
+    let (fm, fn_) = (state_m.frames(), state_n.frames());
+    let (mut raw_m, mut raw_n) = (None, None);
+    for j in 0..fn_.len() {
+        let c_out = *cands & r.home_of[j];
+        let c_in = if j + 1 < r.home_of.len() { *cands & r.home_of[j + 1] } else { Bits::EMPTY };
+        if c_out.is_empty() && c_in.is_empty() {
+            continue;
+        }
+        if j >= fm.len() {
+            return FRAMES;
+        }
+        let mut ms = vec![fm[j]];
+        if mode & RAW_M != 0 {
+            let raw = raw_m.get_or_insert_with(|| raw(&r.model, &r.root, promoted).unwrap_or_default());
+            if let Some(f) = raw.get(j) {
+                ms.push(*f);
+            }
+        }
+        if mode & STRIP != 0 {
+            ms = ms.iter().map(|f| strip(&r.model, f, cands, &c_in)).collect();
+        }
+        let mut ns = vec![fn_[j]];
+        if mode & RAW_N != 0 {
+            let raw = raw_n.get_or_insert_with(|| raw(model_n, root_n, promoted).unwrap_or_default());
+            if let Some(f) = raw.get(j) {
+                ns.push(*f);
+            }
+        }
+        let mut first = None;
+        let mut ok = false;
+        'pairs: for m in &ms {
+            for n in &ns {
+                match compare(model_n, m, n, cands, &c_in) {
+                    Ok(()) => {
+                        ok = true;
+                        break 'pairs;
+                    }
+                    Err(e) => {
+                        if mode & RENAME != 0 && rename(&r.model, model_n, m, n, cands, &c_in) {
+                            ok = true;
+                            break 'pairs;
+                        }
+                        if mode & DISMANTLE != 0 {
+                            let residual = dismantle(&r.model, m, cands, &c_in);
+                            match compare_core(model_n, m, n, cands, &residual) {
+                                Ok(()) => {
+                                    ok = true;
+                                    break 'pairs;
+                                }
+                                Err(e) => {
+                                    first.get_or_insert(e);
+                                }
+                            }
+                        }
+                        first.get_or_insert(e);
+                    }
+                }
+            }
+        }
+        if !ok {
+            let (reason, bad) = first.expect("a pair was compared");
+            *why = bad;
+            return reason;
+        }
+    }
+    HOLDS
+}
+
+/// The references a search cuts by, and the mode.
+type Shared<const W: usize> = (Vec<Reference<W>>, u32);
+
+static REFERENCES: OnceLock<Box<dyn std::any::Any + Send + Sync>> = OnceLock::new();
+
+/// The checks made, and per reason how many ended there (of the first reference), over every searcher.
+pub static CHECKS: AtomicU64 = AtomicU64::new(0);
+pub static REASON_COUNTS: [AtomicU64; REASONS] = [const { AtomicU64::new(0) }; REASONS];
+
+/// Sets the references and the mode for every search of this process.
+pub fn set_references<const W: usize>(references: Vec<Reference<W>>, mode: u32) {
+    let _ = REFERENCES.set(Box::new((references, mode)));
+}
+
+thread_local! {
+    static SCRATCH: std::cell::RefCell<Option<Box<dyn std::any::Any>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Whether a reference cuts the node (see [`check`]), counting the outcome.  False when no reference is set.
+pub fn cuts<const W: usize>(
+    model_n: &FrameGraph,
+    root_n: &FrameSet<W>,
+    state_n: &FrameSet<W>,
+    promoted: &Bits<W>,
+    cands: &Bits<W>,
+    need_total: u64,
+) -> bool {
+    let Some((references, mode)) = REFERENCES.get().and_then(|any| any.downcast_ref::<Shared<W>>()) else {
+        return false;
+    };
+    CHECKS.fetch_add(1, Ordering::Relaxed);
+    SCRATCH.with(|cell| {
+        let mut cell = cell.borrow_mut();
+        let scratch =
+            cell.get_or_insert_with(|| Box::new(Scratch::<W>::new())).downcast_mut::<Scratch<W>>().expect("one width");
+        let mut first = None;
+        let mut why = Bits::EMPTY;
+        for r in references {
+            let reason = check(r, model_n, root_n, state_n, promoted, cands, need_total, *mode, scratch, &mut why);
+            first.get_or_insert(reason);
+            if reason == HOLDS {
+                REASON_COUNTS[HOLDS].fetch_add(1, Ordering::Relaxed);
+                return true;
+            }
+        }
+        REASON_COUNTS[first.unwrap_or(HOLDS)].fetch_add(1, Ordering::Relaxed);
+        false
+    })
+}
+
+/// The counts, as a line for a study's log.
+pub fn report() -> String {
+    let counts: Vec<String> =
+        NAMES.iter().zip(&REASON_COUNTS).map(|(name, c)| format!("{name} {}", c.load(Ordering::Relaxed))).collect();
+    format!("widen: checks {}; {}", CHECKS.load(Ordering::Relaxed), counts.join(", "))
+}
