diff --git a/solver/frame/examples/widen.rs b/solver/frame/examples/widen.rs
new file mode 100644
index 0000000..4fadc48
--- /dev/null
+++ b/solver/frame/examples/widen.rs
@@ -0,0 +1,519 @@
+//! A study of how far the near-repeat cut reaches (the notebook entry
+//! solver/notebook/search/widening-the-near-repeat-cut-2026-10/).  An example of the frame solver kept out of the
+//! build: copy it to solver/frame/examples/ and build it with the feature `studies` and `search::widen`.
+//!
+//! ```text
+//! widen diff M N [--known FILE]
+//! widen units M N --units FILE [--known FILE]
+//! widen greedy M N --units FILE [--known FILE]
+//! widen cover M N --units FILE [--known FILE]
+//! WIDEN_ID=ID widen explain M N --units FILE
+//! TAXMAN_WIDEN_MODE=K widen verify M N --units FILE [--known FILE]
+//! widen fuzz FROM TO [--nodes K]
+//! ```
+//!
+//! `diff` prints what differs between the two games' problems: P*, the candidates of one that are not the other's or
+//! have another home, and per frame the moves and factors of one root that the other lacks.  `units` prints a JSON
+//! line a unit of game N in FILE (a snapshot's units.jsonl): its id, depth and gap, whether game M's P* is at most
+//! N's, and for each mode of `search::widen` (0, Lemma R; 1, with M's free moves stripped; 15, with also both partial
+//! states and a renaming; 16, M's movers dismantled; 31, all) the reason the check fails at the unit's node,
+//! structurally (the bound left out), with the numbers that break it.  `greedy` prints for each unit the heaviest of
+//! a dozen greedy completions in N, whether it is worth more than M's P* (if so, no reference of that bound can cut
+//! the unit), and whether one of them is a promotion set of N and not of M (then no argument that the completions are
+//! sets of M can).  `cover` looks for a small set K of Lemma K at each unit, and `explain` prints, at one unit, which
+//! movers keep the swapped moves of M in its frame.  `verify` tests, at the units where the check of mode K (default
+//! 15) holds, random greedy completions made in N for promotability in M, as the lemmas say they are; `fuzz` does the
+//! same on random nodes of the games FROM to TO against n − 1 and n − 2.
+
+#[allow(dead_code)]
+#[path = "common/fixtures.rs"]
+mod fixtures;
+#[path = "common/known.rs"]
+mod known;
+
+use known::known_incumbent;
+use std::path::PathBuf;
+use taxman::bits::Bits;
+use taxman::board::Board;
+use taxman::game::Optimal;
+use taxman::json::Json;
+use taxman::search::widen::{self, Reference};
+use taxman::search::{Prepared, SearchTactics};
+
+const MODES: [u32; 5] = [0, 1, 15, 16, 31];
+
+fn pstar<const W: usize>(board: &Board<W>, p: &Prepared<W>, optimal: &Optimal) -> Result<u64, String> {
+    Ok(known_incumbent(board, p, optimal)?.ok_or(format!("no known game of {}", board.n()))?.1)
+}
+
+fn diff<const W: usize>(m: u32, n: u32, optimal: &Optimal) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    println!("P*: {m} {}, {n} {}", pstar(&bm, &pm, optimal)?, pstar(&bn, &pn, optimal)?);
+    println!("candidates of {n} only: {:?}", (pn.candidates - pm.candidates).to_vec());
+    println!("candidates of {m} only: {:?}", (pm.candidates - pn.candidates).to_vec());
+    let homes: Vec<(u32, usize, usize)> = (pn.candidates & pm.candidates)
+        .iter()
+        .filter(|&x| pm.model.home(x) != pn.model.home(x))
+        .map(|x| (x, pm.model.home(x), pn.model.home(x)))
+        .collect();
+    println!("another home (number, home in {m}, in {n}): {homes:?}");
+    let (fm, fn_) = (pm.root.frames(), pn.root.frames());
+    for j in 0..fm.len().max(fn_.len()) {
+        let empty = taxman::model::Frame::<W>::default();
+        let (a, b) = (fm.get(j).unwrap_or(&empty), fn_.get(j).unwrap_or(&empty));
+        if a == b {
+            continue;
+        }
+        println!(
+            "frame {j}: moves of {m} only {:?}, of {n} only {:?}; factors of {m} only {:?}, of {n} only {:?}; \
+             freedoms {} and {}",
+            (a.moves - b.moves).to_vec(),
+            (b.moves - a.moves).to_vec(),
+            (a.factors - b.factors).to_vec(),
+            (b.factors - a.factors).to_vec(),
+            a.freedoms,
+            b.freedoms
+        );
+    }
+    Ok(())
+}
+
+fn units<const W: usize>(m: u32, n: u32, file: &str, optimal: &Optimal) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    let (sm, sn) = (pstar(&bm, &pm, optimal)?, pstar(&bn, &pn, optimal)?);
+    let r = Reference::new(pm.model.clone(), pm.root, &pm.candidates, sm, &pn.model, &pn.candidates, pn.root.len())
+        .ok_or("one-sided candidates")?;
+    let text = std::fs::read_to_string(file).map_err(|e| format!("{file}: {e}"))?;
+    let mut scratch = taxman::model::Scratch::new();
+    for line in text.lines() {
+        let json = Json::parse(line).map_err(|e| e.to_string())?;
+        if json.get("kind").and_then(Json::as_str) != Some("unit") {
+            continue;
+        }
+        let get = |k: &str| json.get(k).and_then(Json::as_str).ok_or(format!("no {k}"));
+        let num = |k: &str| json.get(k).and_then(Json::as_i64).unwrap_or(-1);
+        let promoted: Bits<W> = fixtures::from_hex(get("promoted")?)?;
+        let cands: Bits<W> = fixtures::from_hex(get("cands")?)?;
+        let state = pn.model.promote_all_using(&mut scratch, &pn.root, &promoted).ok_or("not promotable in N")?;
+        let mut fields: Vec<(String, Json)> = vec![
+            ("id".into(), Json::from(get("id")?)),
+            ("depth".into(), Json::from(num("depth"))),
+            ("gap".into(), Json::from(num("gap"))),
+            ("bound_ok".into(), Json::from(sm <= sn)),
+        ];
+        for mode in MODES {
+            let mut why = Bits::EMPTY;
+            let reason =
+                widen::check(&r, &pn.model, &pn.root, &state, &promoted, &cands, u64::MAX, mode, &mut scratch,
+                             &mut why);
+            let why: Vec<String> = why.to_vec().iter().take(12).map(|x| x.to_string()).collect();
+            fields.push((format!("m{mode}"), Json::from(widen::NAMES[reason])));
+            fields.push((format!("why{mode}"), Json::from(why.join(" "))));
+        }
+        println!("{}", Json::object(fields));
+    }
+    Ok(())
+}
+
+/// For each unit of N where the check of mode 17 (free moves dropped, movers dismantled) fails on a frame (not on
+/// candidacy or the promotions): a set K of its candidates such that the check holds at the node with the candidates C
+/// less K, if one is found by adding, at most six times, the candidates that pay with a factor of a move that breaks
+/// the check, or with a factor that does, or are one.  Then every completion of the node that beats the incumbent
+/// holds a member of K (Lemma K of the entry), and the node needs only the children that promote a member of K.
+/// Prints the unit, its gap and |K| (or -1).
+fn cover<const W: usize>(m: u32, n: u32, file: &str, optimal: &Optimal) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    let sm = pstar(&bm, &pm, optimal)?;
+    let r = Reference::new(pm.model.clone(), pm.root, &pm.candidates, sm, &pn.model, &pn.candidates, pn.root.len())
+        .ok_or("one-sided candidates")?;
+    let text = std::fs::read_to_string(file).map_err(|e| format!("{file}: {e}"))?;
+    let mut scratch = taxman::model::Scratch::new();
+    let (gm, gn) = (pm.model.graph(), pn.model.graph());
+    for line in text.lines() {
+        let json = Json::parse(line).map_err(|e| e.to_string())?;
+        if json.get("kind").and_then(Json::as_str) != Some("unit") {
+            continue;
+        }
+        let get = |k: &str| json.get(k).and_then(Json::as_str).ok_or(format!("no {k}"));
+        let promoted: Bits<W> = fixtures::from_hex(get("promoted")?)?;
+        let cands: Bits<W> = fixtures::from_hex(get("cands")?)?;
+        let state = pn.model.promote_all_using(&mut scratch, &pn.root, &promoted).ok_or("not promotable in N")?;
+        let mut k = Bits::<W>::EMPTY;
+        let mut size: i64 = -1;
+        for _ in 0..7 {
+            let c = cands - k;
+            let mut why = Bits::EMPTY;
+            let reason =
+                widen::check(&r, &pn.model, &pn.root, &state, &promoted, &c, u64::MAX, 17, &mut scratch, &mut why);
+            if reason == widen::HOLDS {
+                size = i64::from(k.len());
+                break;
+            }
+            if reason != widen::MOVES && reason != widen::FACTORS {
+                break;
+            }
+            // The factors to free: those of the moves that break the check, or the factors that do.
+            let factors: Vec<u32> = if reason == widen::MOVES {
+                why.iter().flat_map(|a| gm.factors(a).iter().map(|&q| u32::from(q))).collect()
+            } else {
+                why.to_vec()
+            };
+            let before = k;
+            for q in factors {
+                if c.contains(q) {
+                    k.insert(q);
+                }
+                for &z in gn.composites(q) {
+                    if c.contains(u32::from(z)) {
+                        k.insert(u32::from(z));
+                    }
+                }
+            }
+            if k == before {
+                break;
+            }
+        }
+        let gap = json.get("gap").and_then(Json::as_i64).unwrap_or(-1);
+        println!("{{\"id\":\"{}\",\"gap\":{gap},\"cover\":{size},\"cands\":{}}}", get("id")?, cands.len());
+    }
+    Ok(())
+}
+
+/// Why the check fails at the first unit of FILE with the id ID: for each frame that M's and N's roots differ in, the
+/// moves of M's frame at the node that N's lacks, and for each factor they pay with, the movers that pay with it in
+/// M's frame (moves, and candidates of the node promoted into the frame), how many of them the dismantling leaves, and
+/// the same for N's frame.
+fn explain<const W: usize>(m: u32, n: u32, file: &str, id: &str) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    let text = std::fs::read_to_string(file).map_err(|e| format!("{file}: {e}"))?;
+    let line = text.lines().find(|l| l.contains(&format!("\"id\":\"{id}\""))).ok_or("no such unit")?;
+    let json = Json::parse(line).map_err(|e| e.to_string())?;
+    let get = |k: &str| json.get(k).and_then(Json::as_str).ok_or(format!("no {k}"));
+    let promoted: Bits<W> = fixtures::from_hex(get("promoted")?)?;
+    let cands: Bits<W> = fixtures::from_hex(get("cands")?)?;
+    let mut scratch = taxman::model::Scratch::new();
+    let sm = pm.model.promote_all_using(&mut scratch, &pm.root, &promoted).ok_or("not promotable in M")?;
+    let sn = pn.model.promote_all_using(&mut scratch, &pn.root, &promoted).ok_or("not promotable in N")?;
+    for j in 0..pm.root.len().min(pn.root.len()) {
+        let (rm, rn) = (&pm.root.frames()[j], &pn.root.frames()[j]);
+        if rm.moves == rn.moves && rm.factors == rn.factors {
+            continue;
+        }
+        let c_in: Bits<W> = cands.iter().filter(|&x| pn.model.home(x) == j + 1).collect();
+        for (name, model, f, other) in
+            [("M", &pm.model, &sm.frames()[j], &sn.frames()[j]), ("N", &pn.model, &sn.frames()[j], &sm.frames()[j])]
+        {
+            let residual = widen::dismantle(model, f, &cands, &c_in);
+            println!(
+                "{name} frame {j}: {} moves ({} in the residual), {} factors, {} candidates promoted into it ({} in \
+                 the residual)",
+                f.moves.len(),
+                (f.moves & residual).len(),
+                f.factors.len(),
+                c_in.len(),
+                (c_in & residual).len()
+            );
+            for a in (f.moves - other.moves).iter() {
+                println!("  move {a} (in the residual: {})", residual.contains(a));
+                for &q in model.graph().factors(a) {
+                    let q = u32::from(q);
+                    if !f.factors.contains(q) {
+                        println!("    {q}: not a factor here");
+                        continue;
+                    }
+                    let payers: Vec<u32> = model.graph().composites(q).iter().map(|&z| u32::from(z))
+                        .filter(|&z| f.moves.contains(z) || c_in.contains(z)).collect();
+                    let moves = payers.iter().filter(|&&z| f.moves.contains(z)).count();
+                    let kept = payers.iter().filter(|&&z| residual.contains(z)).count();
+                    println!("    {q}: paid with by {} movers ({moves} moves), {kept} in the residual", payers.len());
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// For each unit of N: the heaviest of a few greedy completions (the optimum's members first, then by value; by value;
+/// two random orders), each candidate added while the set stays promotable in N.  A unit that holds a promotion set of
+/// N worth more than a reference's bound can never be cut by that reference.
+fn greedy<const W: usize>(m: u32, n: u32, file: &str, optimal: &Optimal) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    let sm = pstar(&bm, &pm, optimal)?;
+    let (opt_set, sn) = known_incumbent(&bn, &pn, optimal)?.ok_or("no known game of N")?;
+    let text = std::fs::read_to_string(file).map_err(|e| format!("{file}: {e}"))?;
+    let mut scratch = taxman::model::Scratch::new();
+    let mut rng = taxman::rng::Rng(3);
+    for line in text.lines() {
+        let json = Json::parse(line).map_err(|e| e.to_string())?;
+        if json.get("kind").and_then(Json::as_str) != Some("unit") {
+            continue;
+        }
+        let get = |k: &str| json.get(k).and_then(Json::as_str).ok_or(format!("no {k}"));
+        let promoted: Bits<W> = fixtures::from_hex(get("promoted")?)?;
+        let cands: Bits<W> = fixtures::from_hex(get("cands")?)?;
+        let state = pn.model.promote_all_using(&mut scratch, &pn.root, &promoted).ok_or("not promotable in N")?;
+        let mut orders: Vec<Vec<u32>> = Vec::new();
+        let mut first: Vec<u32> = (cands & opt_set).iter_desc().collect();
+        first.extend((cands - opt_set).iter_desc());
+        orders.push(first);
+        orders.push(cands.iter_desc().collect());
+        for _ in 0..2 {
+            let mut order = cands.to_vec();
+            rng.shuffle(&mut order);
+            orders.push(order);
+        }
+        // Eight more random orders cut short at random, for the completions of N that are no sets of M.
+        for _ in 0..8 {
+            let mut order = cands.to_vec();
+            rng.shuffle(&mut order);
+            let keep = 1 + (rng.next() as usize) % order.len().max(1);
+            order.truncate(keep);
+            orders.push(order);
+        }
+        let (mut best, mut differs) = (0u64, false);
+        for order in &orders {
+            let mut s = state;
+            let mut set = promoted;
+            for &x in order {
+                if pn.model.promote_in_place_using(&mut scratch, &mut s, x) {
+                    set.insert(x);
+                }
+            }
+            best = best.max(set.sum());
+            differs |= pm.model.promote_all_using(&mut scratch, &pm.root, &set).is_none();
+        }
+        let fields: Vec<(String, Json)> = vec![
+            ("id".into(), Json::from(get("id")?)),
+            ("gap".into(), Json::from(json.get("gap").and_then(Json::as_i64).unwrap_or(-1))),
+            ("greedy".into(), Json::from(best)),
+            ("pstar_m".into(), Json::from(sm)),
+            ("pstar_n".into(), Json::from(sn)),
+            ("above_m".into(), Json::from(best > sm)),
+            ("not_in_m".into(), Json::from(differs)),
+        ];
+        println!("{}", Json::object(fields));
+    }
+    Ok(())
+}
+
+/// For each unit of N where the check of `mode` holds structurally (spread over the file, at most about 600): eight
+/// completions made greedily in N (the unit's candidates by value, or in a random order cut short at random, each
+/// added while the set stays promotable in N), each tested in M.  The lemmas say each is promotable in M; a completion
+/// that is not is a counterexample.
+fn verify<const W: usize>(m: u32, n: u32, file: &str, mode: u32, optimal: &Optimal) -> Result<(), String> {
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    let sm = pstar(&bm, &pm, optimal)?;
+    let r = Reference::new(pm.model.clone(), pm.root, &pm.candidates, sm, &pn.model, &pn.candidates, pn.root.len())
+        .ok_or("one-sided candidates")?;
+    let text = std::fs::read_to_string(file).map_err(|e| format!("{file}: {e}"))?;
+    let lines: Vec<&str> = text.lines().filter(|l| l.contains(r#""kind":"unit""#)).collect();
+    let step = (lines.len() / 600).max(1);
+    let mut scratch = taxman::model::Scratch::new();
+    let mut rng = taxman::rng::Rng(7);
+    let (mut units, mut tested, mut failed) = (0u32, 0u32, 0u32);
+    for line in lines.iter().step_by(step) {
+        let json = Json::parse(line).map_err(|e| e.to_string())?;
+        let get = |k: &str| json.get(k).and_then(Json::as_str).ok_or(format!("no {k}"));
+        let promoted: Bits<W> = fixtures::from_hex(get("promoted")?)?;
+        let cands: Bits<W> = fixtures::from_hex(get("cands")?)?;
+        let state = pn.model.promote_all_using(&mut scratch, &pn.root, &promoted).ok_or("not promotable in N")?;
+        let mut why = Bits::EMPTY;
+        let reason =
+            widen::check(&r, &pn.model, &pn.root, &state, &promoted, &cands, u64::MAX, mode, &mut scratch, &mut why);
+        if reason != widen::HOLDS {
+            continue;
+        }
+        units += 1;
+        for k in 0..8 {
+            let mut order = cands.to_vec();
+            if k == 0 {
+                order.reverse();
+            } else {
+                rng.shuffle(&mut order);
+                let keep = 1 + (rng.next() as usize) % order.len().max(1);
+                order.truncate(keep);
+            }
+            let mut s = state;
+            let mut set = promoted;
+            for &x in &order {
+                if pn.model.promote_in_place_using(&mut scratch, &mut s, x) {
+                    set.insert(x);
+                }
+            }
+            tested += 1;
+            if pm.model.promote_all_using(&mut scratch, &pm.root, &set).is_none() {
+                failed += 1;
+                eprintln!("{}: a completion promotable in {n} and not in {m}", get("id")?);
+            }
+        }
+    }
+    println!("mode {mode}: units where it holds {units}, completions tested {tested}, not promotable in {m}: {failed}");
+    Ok(())
+}
+
+/// The check of the lemmas on random nodes of small games: for each n of FROM..=TO with a known game and a problem
+/// (not a prime), against M = n − 1 and n − 2, `nodes` random nodes of N (P promoted greedily from a random order of
+/// the candidates and cut short at random; C a random part of the candidates left).  At each node, which modes hold
+/// (the bound left out), and for each mode that holds, sixteen random greedy completions in N tested in M.  Prints the
+/// counts per mode and every counterexample.
+fn fuzz(from: u32, to: u32, nodes: u32, optimal: &Optimal) -> Result<(), String> {
+    let mut rng = taxman::rng::Rng(11);
+    let mut holds = [0u64; MODES.len()];
+    let (mut tested, mut failed, mut checked, mut pairs) = ([0u64; MODES.len()], [0u64; MODES.len()], 0u64, 0u32);
+    for n in from..=to {
+        for m in [n.saturating_sub(1), n.saturating_sub(2)] {
+            let r = taxman::with_width!(n, W => fuzz_pair::<W>(m, n, nodes, optimal, &mut rng, &mut holds, &mut tested,
+                                                               &mut failed));
+            match r {
+                Ok(k) => {
+                    checked += k;
+                    pairs += u32::from(k > 0);
+                }
+                Err(e) => eprintln!("{m} {n}: skipped: {e}"),
+            }
+        }
+    }
+    println!("pairs {pairs}, nodes {checked}");
+    for (i, mode) in MODES.iter().enumerate() {
+        println!(
+            "mode {mode}: holds at {} nodes, completions tested {}, not promotable in M: {}",
+            holds[i], tested[i], failed[i]
+        );
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn fuzz_pair<const W: usize>(
+    m: u32,
+    n: u32,
+    nodes: u32,
+    optimal: &Optimal,
+    rng: &mut taxman::rng::Rng,
+    holds: &mut [u64; MODES.len()],
+    tested: &mut [u64; MODES.len()],
+    failed: &mut [u64; MODES.len()],
+) -> Result<u64, String> {
+    if m < 10 {
+        return Err("too small".into());
+    }
+    let (bm, bn) = (Board::<W>::for_n(m), Board::<W>::for_n(n));
+    let (pm, pn) = (bm.prepare(SearchTactics::default())?, bn.prepare(SearchTactics::default())?);
+    if pn.candidates.is_empty() || pm.candidates.is_empty() {
+        return Ok(0);
+    }
+    let sm = pstar(&bm, &pm, optimal).unwrap_or(0);
+    let Some(r) =
+        Reference::new(pm.model.clone(), pm.root, &pm.candidates, sm, &pn.model, &pn.candidates, pn.root.len())
+    else {
+        return Ok(0);
+    };
+    let mut scratch = taxman::model::Scratch::new();
+    let mut count = 0;
+    for _ in 0..nodes {
+        // A random node: P greedy from a random order, cut short; C a random part of the rest.
+        let mut order = pn.candidates.to_vec();
+        rng.shuffle(&mut order);
+        let stop = (rng.next() as usize) % (order.len() + 1);
+        let mut state = pn.root;
+        let mut promoted = Bits::<W>::EMPTY;
+        for &x in &order[..stop] {
+            if pn.model.promote_in_place_using(&mut scratch, &mut state, x) {
+                promoted.insert(x);
+            }
+        }
+        let keep = 1 + rng.next() % 4; // keep each of the rest with probability keep / 4
+        let cands: Bits<W> = (pn.candidates - promoted).iter().filter(|_| rng.next() % 4 < keep).collect();
+        count += 1;
+        for (i, &mode) in MODES.iter().enumerate() {
+            let mut why = Bits::EMPTY;
+            let reason = widen::check(&r, &pn.model, &pn.root, &state, &promoted, &cands, u64::MAX, mode, &mut scratch,
+                                      &mut why);
+            if reason != widen::HOLDS {
+                continue;
+            }
+            holds[i] += 1;
+            for _ in 0..16 {
+                let mut order = cands.to_vec();
+                rng.shuffle(&mut order);
+                let mut s = state;
+                let mut set = promoted;
+                for &x in &order {
+                    if pn.model.promote_in_place_using(&mut scratch, &mut s, x) {
+                        set.insert(x);
+                    }
+                }
+                tested[i] += 1;
+                if pm.model.promote_all_using(&mut scratch, &pm.root, &set).is_none() {
+                    failed[i] += 1;
+                    eprintln!("counterexample: mode {mode}, M {m}, N {n}, set {:?}, promoted {:?}", set.to_vec(),
+                              promoted.to_vec());
+                }
+            }
+        }
+    }
+    Ok(count)
+}
+
+fn run() -> Result<(), String> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let usage = "usage: widen diff|units|greedy|cover|explain|verify M N [--units FILE] [--known FILE] \
+                 | widen fuzz FROM TO [--nodes K]";
+    if args.len() < 3 {
+        return Err(usage.into());
+    }
+    let parse = |s: &str| s.parse::<u32>().map_err(|e| format!("{s}: {e}"));
+    let (m, n) = (parse(&args[1])?, parse(&args[2])?);
+    let (mut known, mut file, mut nodes) = (Vec::new(), None, 200u32);
+    let mut rest = args[3..].iter();
+    while let Some(flag) = rest.next() {
+        let value = rest.next().ok_or(format!("{flag} needs a value"))?;
+        match flag.as_str() {
+            "--known" => known.push(PathBuf::from(value)),
+            "--units" => file = Some(value.clone()),
+            "--nodes" => nodes = value.parse().map_err(|e| format!("{value}: {e}"))?,
+            other => return Err(format!("unknown option {other}; {usage}")),
+        }
+    }
+    let optimal = Optimal::built_in().with_results_files(&known)?;
+    match args[0].as_str() {
+        "diff" => taxman::with_width!(m.max(n), W => diff::<W>(m, n, &optimal)),
+        "units" => {
+            let file = file.ok_or("units needs --units FILE")?;
+            taxman::with_width!(m.max(n), W => units::<W>(m, n, &file, &optimal))
+        }
+        "fuzz" => fuzz(m, n, nodes, &optimal),
+        "explain" => {
+            let file = file.ok_or("explain needs --units FILE")?;
+            let id = std::env::var("WIDEN_ID").map_err(|_| "explain needs WIDEN_ID")?;
+            taxman::with_width!(m.max(n), W => explain::<W>(m, n, &file, &id))
+        }
+        "cover" => {
+            let file = file.ok_or("cover needs --units FILE")?;
+            taxman::with_width!(m.max(n), W => cover::<W>(m, n, &file, &optimal))
+        }
+        "verify" => {
+            let file = file.ok_or("verify needs --units FILE")?;
+            let mode: u32 = std::env::var("TAXMAN_WIDEN_MODE").ok().and_then(|v| v.parse().ok()).unwrap_or(15);
+            taxman::with_width!(m.max(n), W => verify::<W>(m, n, &file, mode, &optimal))
+        }
+        "greedy" => {
+            let file = file.ok_or("greedy needs --units FILE")?;
+            taxman::with_width!(m.max(n), W => greedy::<W>(m, n, &file, &optimal))
+        }
+        _ => Err(usage.into()),
+    }
+}
+
+fn main() {
+    if let Err(e) = run() {
+        eprintln!("widen: {e}");
+        std::process::exit(1);
+    }
+}
