+    /// PROF: marks in `alone` (by element) the live elements alone in their strongly connected component of the
+    /// exchange graph's arcs within `slack` (reduced lengths by `pot`); the number of arcs.
+    pub fn alone_within(&mut self, p: &Problem<'_, R>, pot: &[i64], slack: i64, alone: &mut Vec<bool>) -> u64 {
+        if self.columns_for != self.tableau {
+            self.build_columns();
+        }
+        let n = self.inside.len();
+        let w = p.weight;
+        let w1 = |e: usize| pot[e];
+        let w2 = |e: usize| w[e] - pot[e];
+        let mut adj: Vec<Vec<u32>> = vec![Vec::new(); n];
+        let mut verts: Vec<u32> = Vec::new();
+        let mut arcs = 0u64;
+        for &x in &self.members {
+            let xi = x as usize;
+            verts.push(x);
+            let column = usize::from(p.block[0][xi]) * 64 * R + usize::from(self.slot[0][xi]);
+            for &y in self.columns[column].iter().chain(&self.free_a) {
+                if w1(xi) - w1(y as usize) <= slack {
+                    adj[xi].push(y);
+                    arcs += 1;
+                }
+            }
+        }
+        for &y in self.out_a.iter().flatten() {
+            let yi = y as usize;
+            verts.push(y);
+            if !is_zero(&self.res[1][yi]) {
+                for &z in &self.members {
+                    if w2(z as usize) - w2(yi) <= slack {
+                        adj[yi].push(z);
+                        arcs += 1;
+                    }
+                }
+            } else {
+                let elems = &self.slot_elem[1][usize::from(p.block[1][yi])];
+                each_bit(&self.mask[1][yi], |s| {
+                    let z = elems[s];
+                    if w2(z as usize) - w2(yi) <= slack {
+                        adj[yi].push(z);
+                        arcs += 1;
+                    }
+                });
+            }
+        }
+        // Tarjan, iterative.
+        let mut index = vec![u32::MAX; n];
+        let mut low = vec![0u32; n];
+        let mut on = vec![false; n];
+        let mut stack: Vec<u32> = Vec::new();
+        let mut call: Vec<(u32, usize)> = Vec::new();
+        let mut next = 0u32;
+        alone.clear();
+        alone.resize(n, false);
+        for &s in &verts {
+            if index[s as usize] != u32::MAX {
+                continue;
+            }
+            call.push((s, 0));
+            index[s as usize] = next;
+            low[s as usize] = next;
+            next += 1;
+            stack.push(s);
+            on[s as usize] = true;
+            while let Some(&(v, k)) = call.last() {
+                let vi = v as usize;
+                if k < adj[vi].len() {
+                    let u = adj[vi][k] as usize;
+                    call.last_mut().unwrap().1 += 1;
+                    if index[u] == u32::MAX {
+                        index[u] = next;
+                        low[u] = next;
+                        next += 1;
+                        stack.push(u as u32);
+                        on[u] = true;
+                        call.push((u as u32, 0));
+                    } else if on[u] {
+                        low[vi] = low[vi].min(index[u]);
+                    }
+                } else {
+                    call.pop();
+                    if let Some(&(parent, _)) = call.last() {
+                        let pi = parent as usize;
+                        low[pi] = low[pi].min(low[vi]);
+                    }
+                    if low[vi] == index[vi] {
+                        let mut size = 0;
+                        let mut last = 0;
+                        loop {
+                            let t = stack.pop().unwrap();
+                            on[t as usize] = false;
+                            size += 1;
+                            last = t;
+                            if t == v {
+                                break;
+                            }
+                        }
+                        if size == 1 {
+                            alone[last as usize] = true;
+                        }
+                    }
+                }
+            }
+        }
+        arcs
+    }
