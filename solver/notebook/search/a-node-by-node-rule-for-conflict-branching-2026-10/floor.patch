+/// The floor of conflict branching (tactic `conflict_floor`), which keeps the search's own conflict unless it weighs at
+/// least `CONFLICT_FLOOR`, acts and changes no answer: with conflict branching at every check, whatever its gap, it
+/// changes the tree of some of the games 301 to 500 (every tenth) from the tree without it, and each search comes back
+/// with exactly the sum of `optimal.json`, from an incumbent worth 1 less.
+#[test]
+fn the_floor_changes_the_trees_of_the_small_games_and_not_their_answers() {
+    let optimal = Optimal::built_in();
+    let branching = Config { conflict_branching: Some(0), ..Config::standard() };
+    let floored = Config { conflict_floor: true, ..branching };
+    let mut changed = 0;
+    for n in (301..=500).step_by(10) {
+        let Some(game) = Game::<8>::of_board(n) else { continue };
+        let truth = optimal_sum::<8>(optimal, n).unwrap();
+        let [plain, kept] =
+            [branching, floored].map(|cfg| game.search(cfg, vec![game.root_unit()], truth - 1, None, None));
+        for out in [&plain, &kept] {
+            assert!(out.completed && out.best == truth && out.real, "n={n}: truth {truth}, got {out:?}");
+        }
+        changed += usize::from(plain.nodes != kept.nodes);
+    }
+    assert!(changed > 0, "the floor changed no tree");
+}
