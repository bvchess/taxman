+//! Experimental knobs of the branching study (2026-10-27), read once from the environment.  Not for master.
+
+use std::sync::OnceLock;
+
+#[derive(Debug)]
+pub(super) struct Knobs {
+    /// Conflict branching takes a conflict other than the search's own only if its weight is below `rho` times the
+    /// weight of the search's own (1: as now).
+    pub rho: f64,
+    /// Conflict branching takes a conflict other than the search's own only if the weight of the search's own is at
+    /// least this.
+    pub w0min: f64,
+    /// The weights of the search's own conflict and of the `ctx` lightest others are made again with each member's
+    /// price in the context of its exclusion child (the members before it promoted), from the split's child bound.
+    pub ctx: usize,
+    /// With `ctx`, a child that the split's bound does not bound is solved.
+    pub ctx_solve: bool,
+    /// A trace line at each choice.
+    pub trace: bool,
+    /// The phases of the steps timed, and printed at the end of each unit.
+    pub phases: bool,
+    /// Steps and time by the gap of the node's check, printed at the end of each unit.
+    pub gapprof: bool,
+    /// Counters of strong branching, printed at the end of each unit: calls, conflicts of 2, 3, 4 and 5 or more
+    /// members, the split's first member chosen, forced members found, members solved, nanoseconds in the certified
+    /// reads and in the rest, and the margin between the two lowest bounds (0, 1-10, 11-50, more).
+    pub sbstat: bool,
+    /// The slope of the weight (291 by default).
+    pub slope: f64,
+    /// Where `ctx` is on, a child the split's bound shows dead weighs nothing (its price is the gap).
+    pub look_price: f64,
+}
+
+pub(super) fn get() -> &'static Knobs {
+    static K: OnceLock<Knobs> = OnceLock::new();
+    K.get_or_init(|| {
+        let f = |name: &str, default: f64| {
+            std::env::var(name).ok().and_then(|v| v.parse::<f64>().ok()).unwrap_or(default)
+        };
+        let k = Knobs {
+            rho: f("TAXMAN_BR_RHO", 1.0),
+            w0min: f("TAXMAN_BR_W0MIN", 0.0),
+            ctx: f("TAXMAN_BR_CTX", 0.0) as usize,
+            ctx_solve: std::env::var_os("TAXMAN_BR_CTXSOLVE").is_some(),
+            trace: std::env::var_os("TAXMAN_BR_TRACE").is_some(),
+            phases: std::env::var_os("TAXMAN_BR_PHASES").is_some(),
+            gapprof: std::env::var_os("TAXMAN_BR_GAPPROF").is_some(),
+            sbstat: std::env::var_os("TAXMAN_BR_SBSTAT").is_some(),
+            slope: f("TAXMAN_BR_SLOPE", super::CONFLICT_BRANCHING_SLOPE),
+            look_price: f("TAXMAN_BR_LOOKPC", super::CONFLICT_LOOK_PRICE),
+        };
+        eprintln!("knobs: {k:?}");
+        k
+    })
+}
