+// ---------------------------------------------------------------------------------------------------------
+// A study of when a node should use conflict branching (feature `studies`): switches read once from the environment
+
+/// What the study's environment says: `TAXMAN_CB_TRACE` (set: a line to stderr at every step, check and choice) and
+/// `TAXMAN_CB_POLICY`, a comma-separated list of the rules that decide where a node uses conflict branching.
+#[cfg(feature = "studies")]
+pub(crate) mod study {
+    use std::sync::OnceLock;
+
+    #[derive(Debug, Default)]
+    pub struct Study {
+        /// `TAXMAN_CB_TRACE`: 1 the short trace, 2 with every member's price.
+        pub trace: bool,
+        pub trace_prices: bool,
+        /// `TAXMAN_CB_TRACE_LOOKS` set: a line to stderr for each look of the rule `look`.
+        pub trace_looks: bool,
+        /// `maxdepth=D`: conflict branching only at nodes of fewer than D promotions.
+        pub max_depth: Option<u32>,
+        /// `keep1`: the search's own conflict where it has one member.
+        pub keep1: bool,
+        /// `look=M`: before branching on another conflict, look at the child that promotes the strong member of up
+        /// to M two-member conflicts that would weigh less than it with that child cut on sight; branch on the first
+        /// whose child is (lightest first).  `lookall`: every two-member conflict seen, not only the search's own.
+        pub look: usize,
+        pub look_all: bool,
+        /// `lookn`: `look` also at conflicts of three members or more.
+        pub look_n: bool,
+        /// `lookpc=P`: look only where the cheapest member's price is at most P; `lookk=K`: only at conflicts of at
+        /// most K members.
+        pub look_pc: Option<f64>,
+        pub look_k: Option<u32>,
+        /// `lookslack=A`: look at a conflict, and branch on it if its last child is cut, while its weight less its
+        /// cheapest member's is below A times the best weight (1 by default).
+        pub look_slack: f64,
+        /// `skipforced`: the search's own conflict where the weight split forces members (the node's one child
+        /// promotes them, whichever conflict it branches on).
+        pub skip_forced: bool,
+        /// `forced0`: a member whose price is at least the gap (forced: the child without it is empty) weighs 0.
+        pub forced0: bool,
+        /// `after=X`: conflict branching only at a node whose subtree has taken X steps or more so far (a node's
+        /// first check, made when it is made, never uses it unless X is 0).
+        pub after: Option<u64>,
+        /// `slope=S`: the weight's slope (`CONFLICT_BRANCHING_SLOPE`, 291, by default).
+        pub slope: Option<f64>,
+        /// `ema=T`: conflict branching only while the searcher's moving average (over the last 16 or so) of how
+        /// often the child of a two-member conflict with no member forced is cut on sight is below T.
+        pub ema: Option<f64>,
+    }
+
+    pub fn get() -> &'static Study {
+        static STUDY: OnceLock<Study> = OnceLock::new();
+        STUDY.get_or_init(|| {
+            let level = std::env::var("TAXMAN_CB_TRACE").ok().and_then(|v| v.parse::<u32>().ok()).unwrap_or(0);
+            let mut s = Study {
+                trace: level >= 1,
+                trace_prices: level >= 2,
+                trace_looks: std::env::var_os("TAXMAN_CB_TRACE_LOOKS").is_some(),
+                look_slack: 1.0,
+                ..Study::default()
+            };
+            let policy = std::env::var("TAXMAN_CB_POLICY").unwrap_or_default();
+            for part in policy.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+                match part.split_once('=') {
+                    Some(("maxdepth", v)) => s.max_depth = Some(v.parse().expect("maxdepth=D")),
+                    Some(("look", v)) => s.look = v.parse().expect("look=M"),
+                    Some(("lookpc", v)) => s.look_pc = Some(v.parse().expect("lookpc=P")),
+                    Some(("lookk", v)) => s.look_k = Some(v.parse().expect("lookk=K")),
+                    Some(("lookslack", v)) => s.look_slack = v.parse().expect("lookslack=A"),
+                    Some(("after", v)) => s.after = Some(v.parse().expect("after=X")),
+                    Some(("slope", v)) => s.slope = Some(v.parse().expect("slope=S")),
+                    Some(("ema", v)) => s.ema = Some(v.parse().expect("ema=T")),
+                    None if part == "keep1" => s.keep1 = true,
+                    None if part == "lookall" => s.look_all = true,
+                    None if part == "lookn" => s.look_n = true,
+                    None if part == "skipforced" => s.skip_forced = true,
+                    None if part == "forced0" => s.forced0 = true,
+                    _ => panic!("TAXMAN_CB_POLICY: unknown rule {part}"),
+                }
+            }
+            eprintln!("study: {s:?}");
+            s
+        })
+    }
+}
