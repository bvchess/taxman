+                            if let Some(nogood) = model.nogood(scratch, l.root, &promoted, &k) {
+                                l.table.insert(nogood);
+                            }
+                        }
+                        true
+                    }
+                    _ => false,
+                }
+            }
+        }
+    };
+    g.pop();
+    cut
+}
