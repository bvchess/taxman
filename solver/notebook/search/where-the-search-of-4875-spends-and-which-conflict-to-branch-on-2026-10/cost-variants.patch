+/// Exploration only: the price past which the tactic `conflict_branching` prices no member exactly
+/// (`TAXMAN_CB_LIMIT`), if set.
+fn price_limit() -> Option<f64> {
+    static LIMIT: std::sync::OnceLock<Option<f64>> = std::sync::OnceLock::new();
+    *LIMIT.get_or_init(|| std::env::var("TAXMAN_CB_LIMIT").ok().and_then(|v| v.parse().ok()))
+}
+
+/// Exploration only: price exactly only the members of the conflicts weighed (`TAXMAN_CB_LATE`).
+fn price_late() -> bool {
+    static LATE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *LATE.get_or_init(|| std::env::var("TAXMAN_CB_LATE").is_ok())
+}
+
+/// Exploration only: the price from which k0 is kept unweighed (`TAXMAN_CB_ENOUGH`).
+fn price_enough() -> Option<f64> {
+    static ENOUGH: std::sync::OnceLock<Option<f64>> = std::sync::OnceLock::new();
+    *ENOUGH.get_or_init(|| std::env::var("TAXMAN_CB_ENOUGH").ok().and_then(|v| v.parse().ok()))
+}
