+fn knobs() -> &'static Knobs {
+    static KNOBS: OnceLock<Knobs> = OnceLock::new();
+    KNOBS.get_or_init(|| {
+        let k = |name: &str| std::env::var(name).ok().and_then(|v| v.parse::<i64>().ok()).unwrap_or(0);
+        Knobs {
+            lazy: k("TAXMAN_CH_LAZY"),
+            mid: k("TAXMAN_CH_MID"),
+            c: k("TAXMAN_CH_C"),
+            rho: k("TAXMAN_CH_RHO"),
+            floor: k("TAXMAN_CH_FLOOR"),
+            nolearn: k("TAXMAN_CH_NOLEARN"),
+            nolook: k("TAXMAN_CH_NOLOOK"),
+            top: k("TAXMAN_CH_TOP"),
+            slope: k("TAXMAN_CH_SLOPE"),
+            nostack: k("TAXMAN_CH_NOSTACK"),
+            ch: k("TAXMAN_CH"),
+            cap: k("TAXMAN_CH_CAP"),
+            stop: k("TAXMAN_CH_STOP"),
+            iter: k("TAXMAN_CH_ITER"),
