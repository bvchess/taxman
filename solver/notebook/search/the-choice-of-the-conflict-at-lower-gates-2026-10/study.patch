+/// STUDY: the knobs of the cheaper choice, read once from the environment.
+struct Knobs {
+    /// The split's estimate made only where it is read (exact: the same choices).
+    lazy: i64,
+    /// The top of the mid band (0: none): the rules below act at nodes whose gap is under it.
+    mid: i64,
+    /// In the mid band: a term added to the weight for each member (thousandths).
+    c: i64,
+    /// In the mid band: another conflict than `k0` only if it weighs under this share of `k0`'s weight (thousandths).
+    rho: i64,
+    /// In the mid band: `k0` priced first and kept where it weighs under this (thousandths).
+    floor: i64,
+    /// In the mid band: the conflicts chosen are not learned as nogoods.
+    nolearn: i64,
+    /// In the mid band: no look.
+    nolook: i64,
+    /// No choice at a gap of this or more (0: none).
+    top: i64,
+    /// In the mid band: the slope of the weight in place of `CONFLICT_BRANCHING_SLOPE` (0: that).
+    slope: i64,
+    /// In the mid band: no choice where the parent's last check chose another conflict (1), or made a choice (2); a
+    /// choice only where the parent's chose another (3).
+    nostack: i64,
+    /// 0: the choice as it is; 1: only the members of the candidate conflicts priced, the ordered conflicts made in
+    /// the order of the prices known (the split's estimate for the others); 2: 1, each candidate's members priced one
+    /// at a time, the candidate dropped once its known terms reach the best weight.
+    ch: i64,
+    /// The longest search for a member's price (0: the reach).
+    cap: i64,
+    /// With 2, each member's search limited to the price at which its candidate would be dropped.
+    stop: i64,
+    /// Rounds of making the ordered conflicts again with the prices found (0: none).
+    iter: i64,
+}
