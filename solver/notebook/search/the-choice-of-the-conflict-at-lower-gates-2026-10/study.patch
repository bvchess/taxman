diff --git a/solver/frame/src/prof.rs b/solver/frame/src/prof.rs
new file mode 100644
index 0000000..6cb17e2
--- /dev/null
+++ b/solver/frame/src/prof.rs
@@ -0,0 +1,83 @@
+//! TEMPORARY: counters for profiling a step (rdtsc timers by id).  Not for commit.
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering::Relaxed};
+
+pub const N: usize = 1200;
+pub static CYC: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+pub static CNT: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+/// The kind of level being worked on (set by the bound's entries), for the workspace's counters.
+pub static KIND: AtomicUsize = AtomicUsize::new(0);
+
+#[inline(always)]
+pub fn now() -> u64 {
+    // SAFETY: rdtsc has no preconditions on x86_64.
+    unsafe { core::arch::x86_64::_rdtsc() }
+}
+
+#[inline(always)]
+pub fn add(i: usize, amount: u64) {
+    CYC[i].fetch_add(amount, Relaxed);
+    CNT[i].fetch_add(1, Relaxed);
+}
+
+/// Counts `n` under `i` without time.
+#[inline(always)]
+pub fn count(i: usize, n: u64) {
+    CYC[i].fetch_add(n, Relaxed);
+    CNT[i].fetch_add(1, Relaxed);
+}
+
+#[inline(always)]
+pub fn kind() -> usize {
+    KIND.load(Relaxed)
+}
+
+#[inline(always)]
+pub fn set_kind(k: usize) {
+    KIND.store(k, Relaxed)
+}
+
+/// Sets the kind until dropped, then puts back the one before.
+pub struct Kind(usize);
+
+impl Kind {
+    #[inline(always)]
+    pub fn new(k: usize) -> Self {
+        let before = kind();
+        set_kind(k);
+        Kind(before)
+    }
+}
+
+impl Drop for Kind {
+    #[inline(always)]
+    fn drop(&mut self) {
+        set_kind(self.0);
+    }
+}
+
+pub struct T(usize, u64);
+
+impl T {
+    #[inline(always)]
+    pub fn new(i: usize) -> Self {
+        T(i, now())
+    }
+}
+
+impl Drop for T {
+    #[inline(always)]
+    fn drop(&mut self) {
+        add(self.0, now() - self.1);
+    }
+}
+
+pub fn report() -> String {
+    let mut s = String::new();
+    for i in 0..N {
+        let (c, n) = (CYC[i].load(Relaxed), CNT[i].load(Relaxed));
+        if n > 0 {
+            s.push_str(&format!("PROF {:4} {:>16} {:>12}\n", i, c, n));
+        }
+    }
+    s
+}
