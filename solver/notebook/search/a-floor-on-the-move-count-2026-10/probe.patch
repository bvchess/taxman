+//! The floor probe's helper (never merged): the length of the game with no promotions, for each game named.
+//!
+//! ```text
+//! cargo run --profile test --example floor_plain -- N...
+//! ```
+//!
+//! Prints a line `n plain_len in_the_bag` for each N.  A recorded game's moves, less its promotions, are the moves of
+//! the game with no promotions (`Board::plain`): each promotion adds one move
+//! (`taxman::accelerate::solution_for_promotions`).
+
+use taxman::board::Board;
+
+fn main() {
+    for arg in std::env::args().skip(1) {
+        let n: u32 = arg.parse().expect("a game number");
+        taxman::with_width!(
+            n,
+            W => {
+                let board = Board::<W>::for_n(n);
+                println!("{n} {} {}", board.plain.len(), board.in_the_bag);
+            },
+            else panic!("n={n} is beyond the widest set")
+        );
+    }
+}
