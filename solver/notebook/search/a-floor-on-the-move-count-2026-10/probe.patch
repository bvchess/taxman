+//! PROBE, unsound by design and never merged: a floor on the number of promotions of a game, and what it saves.
+//!
+//! In the frame model a game's moves are the moves of the game with no promotions plus one move for each promotion
+//! (`accelerate::solution_for_promotions`), so "the move count of game n is at least that of game n − 1" is "a game of
+//! n has at least `F = moves(n − 1) − plain(n)` promotions", where `plain(n)` is the length of the game of n with no
+//! promotions.  Nobody has proven that some optimal game keeps the count, so a search with the floor proves nothing;
+//! it measures how much the floor would save if it were a theorem.
+//!
+//! The floor is `F`, set by the environment variable `TAXMAN_FLOOR` (off when it is unset).  At a node of `p`
+//! promotions, whose bound check has found the heaviest common independent set `I*` of its live candidates with at
+//! most `cap` members worth at least `need`, a completion must add `r = F − p` promotions.  If `r ≤ |I*|` the floor says
+//! nothing (`I*` has enough).  Else, the weights of the heaviest common independent sets by size are concave and `I*`
+//! is the heaviest of all sizes, so the heaviest with at least `r` members is the heaviest with exactly `r`
+//! ([`Gf2Bound::heaviest_at_least`](crate::gf2::Gf2Bound::heaviest_at_least)).  The node is cut when `r > cap`, when no
+//! common independent set has `r` members, or when the heaviest has a weight below `need`.  The cut is made before the
+//! check looks for a conflict, so that nothing is learned from it, as nothing is from the ordinary cut of the bound.
+//!
+//! The counters are the process's, since a probe runs on one thread; `wall images --count` prints them.
+
+use crate::gf2::{Eval, Gf2Bound};
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+static FLOOR: OnceLock<Option<u32>> = OnceLock::new();
+
+/// The floor in promotions: `TAXMAN_FLOOR`, if it is set to a number.
+pub fn floor() -> Option<u32> {
+    *FLOOR.get_or_init(|| std::env::var("TAXMAN_FLOOR").ok().and_then(|text| text.trim().parse().ok()))
+}
+
+static OPEN: AtomicU64 = AtomicU64::new(0);
+static TIGHT: AtomicU64 = AtomicU64::new(0);
+static SPARE: AtomicU64 = AtomicU64::new(0);
+static APPLIES: AtomicU64 = AtomicU64::new(0);
+static OVER_CAP: AtomicU64 = AtomicU64::new(0);
+static SOLVES: AtomicU64 = AtomicU64::new(0);
+static NO_SET: AtomicU64 = AtomicU64::new(0);
+static BELOW_NEED: AtomicU64 = AtomicU64::new(0);
+static CUTS: AtomicU64 = AtomicU64::new(0);
+static AUGMENTATIONS: AtomicU64 = AtomicU64::new(0);
+static NANOS: AtomicU64 = AtomicU64::new(0);
+
+/// The counters as `(name, value)` pairs, for a line of output: the floor; the bound checks the ordinary cut let
+/// through (`floor_open`); of those, where `I*` has exactly the members the floor asks for (`floor_tight`) and the
+/// members it has to spare over all the checks where it has enough (`floor_spare`); where the floor asked for more
+/// members than `I*` has (`floor_applies`); of those,
+/// where it asked for more than the node can add (`floor_over_cap`), where a solve found no set of that many
+/// (`floor_no_set`) and where the set found was below `need` (`floor_below_need`); the nodes cut (`floor_cuts`, the
+/// sum of the three); the solves made, their augmentations and their nanoseconds.
+pub fn totals() -> Vec<(&'static str, u64)> {
+    vec![
+        ("floor", floor().map_or(0, u64::from)),
+        ("floor_open", OPEN.load(Relaxed)),
+        ("floor_tight", TIGHT.load(Relaxed)),
+        ("floor_spare", SPARE.load(Relaxed)),
+        ("floor_applies", APPLIES.load(Relaxed)),
+        ("floor_over_cap", OVER_CAP.load(Relaxed)),
+        ("floor_no_set", NO_SET.load(Relaxed)),
+        ("floor_below_need", BELOW_NEED.load(Relaxed)),
+        ("floor_cuts", CUTS.load(Relaxed)),
+        ("floor_solves", SOLVES.load(Relaxed)),
+        ("floor_augmentations", AUGMENTATIONS.load(Relaxed)),
+        ("floor_ns", NANOS.load(Relaxed)),
+    ]
+}
+
+/// Whether the floor `floor` cuts a node of `promoted` promotions that can add `cap` more, whose bound check has just
+/// evaluated `eval` (worth at least `need`) on `g`.
+pub fn cuts<const W: usize>(
+    g: &mut Gf2Bound<'_, W>,
+    floor: u32,
+    promoted: u32,
+    cap: u32,
+    eval: &Eval<W>,
+    need: u64,
+) -> bool {
+    OPEN.fetch_add(1, Relaxed);
+    let least = floor.saturating_sub(promoted);
+    let members = eval.chosen.len();
+    if least <= members {
+        // The floor has nothing to say: how many checks were one member short of it, and the members to spare.
+        TIGHT.fetch_add(u64::from(least == members), Relaxed);
+        SPARE.fetch_add(u64::from(members - least), Relaxed);
+        return false;
+    }
+    APPLIES.fetch_add(1, Relaxed);
+    if least > cap {
+        OVER_CAP.fetch_add(1, Relaxed);
+        CUTS.fetch_add(1, Relaxed);
+        return true;
+    }
+    let start = Instant::now();
+    let found = g.heaviest_at_least(least);
+    NANOS.fetch_add(start.elapsed().as_nanos() as u64, Relaxed);
+    SOLVES.fetch_add(1, Relaxed);
+    let cut = match found {
+        None => {
+            NO_SET.fetch_add(1, Relaxed);
+            true
+        }
+        Some((value, augmentations)) => {
+            AUGMENTATIONS.fetch_add(augmentations, Relaxed);
+            let below = value < need;
+            if below {
+                BELOW_NEED.fetch_add(1, Relaxed);
+            }
+            below
+        }
+    };
+    if cut {
+        CUTS.fetch_add(1, Relaxed);
+    }
+    cut
+}
