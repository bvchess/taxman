+/// PROBE (the floor on the move count): on the boards to 200 with at most 13 elements, with random weights (some of
+/// the elements heavy enough to block several lighter ones, so that the heaviest set is not the largest), after an
+/// evaluation under a limit on the size [`Gf2Bound::heaviest_at_least`] finds the weight of the heaviest common
+/// independent set of at least that many elements within the limit (by enumeration), or none, for every number above
+/// the heaviest set's size; and it leaves the level as it was (the same evaluation after).
+#[test]
+fn the_heaviest_set_of_at_least_so_many_candidates_on_small_boards() {
+    const W: usize = 8;
+    let mut rng = Rng(0xF100_0000_0000_0002);
+    let (mut checked, mut found, mut missing, mut lower) = (0, 0, 0, 0);
+    for n in 2..=200 {
+        let board = Board::<W>::for_n(n);
+        if board.is_trivial() {
+            continue;
+        }
+        let p = board.prepare(SearchTactics::default()).unwrap();
+        let numbers = Gf2Graph::new(&p.model, &p.root, &p.candidates);
+        if numbers.len() > 13 {
+            continue;
+        }
+        for _ in 0..4 {
+            // Weights 1, 3, 9, ..., 243: one heavy element can outweigh several light ones.
+            let weights: Vec<i64> = (0..=n).map(|_| 3i64.pow(rng.below(6) as u32)).collect();
+            let (graph, _) = numbers.reweighted(|x| weights[x as usize]);
+            let all: Bits<W> = (1..=graph.len() as u32).collect();
+            let mut bound = Gf2Bound::<W>::new(&graph);
+            bound.reset(&Bits::EMPTY, &all);
+            let cap = 1 + rng.below(graph.len() as u64 + 1) as u32;
+            let eval = bound.evaluate(cap, None);
+            let mut by_size: Vec<Option<u64>> = vec![None; graph.len() + 2];
+            for mask in 0u32..1 << graph.len() {
+                let set: Bits<W> = (0..graph.len()).filter(|&i| mask >> i & 1 == 1).map(|i| graph.elems[i]).collect();
+                if set.len() <= cap && independent(&graph, &set) {
+                    let weight = set.iter().map(|x| graph.weight[x as usize - 1] as u64).sum();
+                    by_size[set.len() as usize] = by_size[set.len() as usize].max(Some(weight));
+                }
+            }
+            for least in eval.chosen.len() + 1..=cap {
+                let wanted = by_size[least as usize..].iter().copied().max().flatten();
+                let got = bound.heaviest_at_least(least).map(|(value, _)| value);
+                assert_eq!(got, wanted, "n={n}, cap {cap}: the heaviest set of at least {least} candidates");
+                if let Some(value) = got {
+                    found += 1;
+                    lower += usize::from(value < eval.value);
+                } else {
+                    missing += 1;
+                }
+                assert_eq!(bound.evaluate(cap, None), eval, "n={n}: the level after asking for {least}");
+            }
+            checked += 1;
+        }
+    }
+    assert!(checked > 100 && found >= 1 && missing > 100 && lower >= 1, "{checked} {found} {missing} {lower}");
+}
