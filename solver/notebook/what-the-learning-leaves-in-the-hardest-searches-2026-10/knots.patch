+// ---------------------------------------------------------------------------------------------------------
+// The knots
+
+/// A node kept for the knot's measure (`--knots`): its step, the steps under it (from `start`, its own step for a
+/// check and its next step for an exclusion, to `end`, the step that ended its loop), its depth, the member it goes
+/// on without (for an exclusion), promotions, candidates, the most promotions a
+/// completion adds, its bound and need, whether its conflict was computed, and its *knot*: the conflict first, then the
+/// minimal conflicts within the closure of its images under the cheap exchanges.
+pub(super) struct Snapshot<const W: usize> {
+    step: u64,
+    start: u64,
+    end: u64,
+    depth: usize,
+    member: Option<u32>,
+    promoted: Bits<W>,
+    cands: Bits<W>,
+    cap: u32,
+    value: u64,
+    need: u64,
+    computed: bool,
+    knot: Vec<Bits<W>>,
+}
+
+/// The most bound evaluations of one knot's measure.
+const KNOT_EVALUATIONS: usize = 400;
+
+/// What a knot's measure found: the bound again (`base`; for an exclusion, without its member), the bound with the
+/// conflict alone imposed (`single`: the best without one of its members), with the whole knot imposed (`knotted`:
+/// the heaviest set of the node's candidates, without the exclusion's member, that holds none of the knot's
+/// conflicts whole, by best-first search over the members left out), the evaluations, whether they ran out
+/// (`knotted` is then an upper bound), and the members left out at the best.
+struct Measure<const W: usize> {
+    base: u64,
+    single: u64,
+    knotted: u64,
+    evaluations: usize,
+    truncated: bool,
+    left_out: Bits<W>,
+}
+
+/// The knot's measure of the node `s`, with the root's GF(2) bound `g`.
+fn measure<const W: usize>(g: &mut Gf2Bound<'_, W>, s: &Snapshot<W>) -> Measure<W> {
+    let mut eval = |out: &Bits<W>| {
+        g.reset(&s.promoted, &(s.cands - *out));
+        let e = g.evaluate(s.cap, None);
+        (e.value, e.chosen)
+    };
+    let first = s.member.map_or(Bits::EMPTY, |x| Bits::EMPTY.with(x));
+    let (base, chosen) = eval(&first);
+    let single = s.knot[0].iter().map(|x| eval(&first.with(x)).0).max().unwrap_or(0);
+    let mut evaluations = 1 + s.knot[0].len() as usize;
+    // Best first: the open sets of members left out, by their bound; the first whose heaviest set holds no conflict of
+    // the knot whole is the best, since leaving out more never raises a bound.
+    let mut open: Vec<(Bits<W>, Bits<W>)> = vec![(first, chosen)];
+    let mut heap = BinaryHeap::from([(base, 0usize)]);
+    let mut seen: HashSet<Bits<W>> = HashSet::from([first]);
+    let (mut knotted, mut truncated, mut left_out) = (base, false, first);
+    while let Some((value, i)) = heap.pop() {
+        let (out, chosen) = open[i];
+        let Some(k) = s.knot.iter().find(|k| k.is_subset(&chosen)) else {
+            (knotted, left_out) = (value, out);
+            break;
+        };
+        if evaluations >= KNOT_EVALUATIONS {
+            (knotted, truncated, left_out) = (value, true, out);
+            break;
+        }
+        for x in k.iter() {
+            let more = out.with(x);
+            if seen.insert(more) {
+                evaluations += 1;
+                let (v, c) = eval(&more);
+                open.push((more, c));
+                heap.push((v, open.len() - 1));
+            }
+        }
+    }
+    Measure { base, single, knotted, evaluations, truncated, left_out }
+}
+
+/// Measures the knots that `game` kept, and writes them to `path` if given; returns how many, and how many had a bound
+/// other than the check's.
+fn measure_knots<const W: usize>(p: &Prepared<W>, game: &Game<W>, path: Option<&Path>) -> Result<(usize, usize), String> {
+    let snapshots = std::mem::take(&mut *game.snapshots.lock().unwrap_or_else(PoisonError::into_inner));
+    let graph = Gf2Graph::new(&p.model, &p.root, &p.candidates);
+    let mut g = Gf2Bound::<W>::new(&graph);
+    let join = |b: &Bits<W>| b.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(",");
+    let mut lines = Vec::new();
+    let mut differ = 0;
+    for s in &snapshots {
+        let m = measure(&mut g, s);
+        differ += usize::from(s.member.is_none() && m.base != s.value);
+        let members = s.knot.iter().fold(Bits::<W>::EMPTY, |a, k| a | *k).len();
+        let fields = [
+            s.step.to_string(),
+            s.start.to_string(),
+            s.end.to_string(),
+            s.member.unwrap_or(0).to_string(),
+            s.depth.to_string(),
+            s.promoted.len().to_string(),
+            u8::from(s.computed).to_string(),
+            s.value.to_string(),
+            m.base.to_string(),
+            s.need.to_string(),
+            s.knot[0].len().to_string(),
+            s.knot.len().to_string(),
+            members.to_string(),
+            (m.base - m.single).to_string(),
+            (m.base - m.knotted).to_string(),
+            m.evaluations.to_string(),
+            u8::from(m.truncated).to_string(),
+            m.left_out.len().to_string(),
+            join(&m.left_out),
+            join(&s.knot[0]),
+        ];
+        lines.push(fields.join("\t"));
+    }
+    if let Some(path) = path {
+        let header =
+            "step\tstart\tend\tx\td\tnp\tkc\tvalue\tbase\tneed\tnk\tknot\tmembers\tfall1\tfallk\tevals\ttrunc\tnout\tout\tconflict";
+        write_lines(path, header, lines)?;
+    }
+    Ok((snapshots.len(), differ))
+}
