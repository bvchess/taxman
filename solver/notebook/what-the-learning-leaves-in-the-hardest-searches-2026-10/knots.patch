+/// The images of the conflict `k` under every twin swap of a member, whatever its price: a member `a = m·p` replaced
+/// by a candidate `m·q` outside `k` (`q` prime), added to `out` (each once).
+fn twin_images<const W: usize>(spf: &[u32], k: &Bits<W>, cands: &Bits<W>, out: &mut Vec<Bits<W>>) {
+    let top = cands.max().unwrap_or(0);
+    for a in k.iter() {
+        let mut rest = a;
+        while rest > 1 {
+            let p = spf[rest as usize];
+            while rest.is_multiple_of(p) {
+                rest /= p;
+            }
+            let m = a / p;
+            for q in (2..=top / m).filter(|&q| q != p && is_prime(q, spf)) {
+                let twin = m * q;
+                let image = k.without(a).with(twin);
+                if cands.contains(twin) && !k.contains(twin) && !out.contains(&image) {
+                    out.push(image);
+                }
+            }
+        }
+    }
+}
