+impl<const W: usize> Learner<W> {
+    /// The images of `conflict` under the cheap exchanges at a node with the state `state`, the candidates `cands` and
+    /// the heaviest set `chosen`, put in `more`; with `closure`, the images of the images that are conflicts too, and
+    /// so on: the conflict's class closed under the cheap exchanges, up to CLOSURE sets, without the conflict.
+    fn images(
+        &mut self,
+        state: &FrameSet<W>,
+        cands: &Bits<W>,
+        chosen: &Bits<W>,
+        conflict: &Bits<W>,
+        closure: bool,
+        more: &mut Vec<Bits<W>>,
+    ) {
+        let game = Arc::clone(&self.game);
+        cheap_images(&game.spf, conflict, cands, chosen, more);
+        if closure {
+            let mut i = 0;
+            while i < more.len() && more.len() < CLOSURE {
+                let image = more[i];
+                i += 1;
+                if game.model.conflict_using(&mut self.scratch, state, &image, false).is_some() {
+                    cheap_images(&game.spf, &image, cands, chosen, more);
+                }
+            }
+            more.retain(|image| image != conflict);
+        }
+    }
+
+    /// Keeps a node for the knot's measure: its state, promotions and candidates, its conflict `k` (of the heaviest set
+    /// `chosen`, at the bound `value`, against `need`), the minimal conflicts within the closure of `k`'s images, and
+    /// the member it goes on without, for an exclusion.  Returns its index.
+    #[allow(clippy::too_many_arguments)]
+    fn snapshot(
+        &mut self,
+        state: &FrameSet<W>,
+        (promoted, cands): (Bits<W>, Bits<W>),
+        chosen: &Bits<W>,
+        (value, need): (u64, u64),
+        computed: bool,
+        k: &Bits<W>,
+        member: Option<u32>,
+    ) -> usize {
+        let mut images = Vec::new();
+        self.images(state, &cands, chosen, k, true, &mut images);
+        if self.game.wide {
+            twin_images(&self.game.spf, k, &cands, &mut images);
+        }
+        let game = Arc::clone(&self.game);
+        let mut knot = vec![*k];
+        for image in &images {
+            if let Some(c) = game.model.conflict_using(&mut self.scratch, state, image, true) {
+                if !knot.contains(&c) {
+                    knot.push(c);
+                }
+            }
+        }
+        let cap = max_additional(&game.model, game.max_total, state, &promoted, &cands);
+        let (step, depth) = (self.tally.steps, self.shape.depth);
+        let snapshot =
+            Snapshot { step, start: step, end: step, depth, member, promoted, cands, cap, value, need, computed, knot };
+        self.snapshots.push(snapshot);
+        self.snapshots.len() - 1
+    }
+
+    /// With `--knots`: keeps the step's node check or exclusion, every N-th, and follows the loops of those kept.
+    fn knots(&mut self, every: u64, r: &StepRecord<W>, state: &FrameSet<W>) {
+        let d = self.shape.depth;
+        if self.last.len() < d + 2 {
+            self.last.resize(d + 2, None);
+            self.open.resize_with(d + 2, Vec::new);
+            self.waiting.resize_with(d + 2, Vec::new);
+        }
+        // The node's next step after an exclusion kept: the steps under the exclusion begin.
+        for i in std::mem::take(&mut self.waiting[d]) {
+            self.snapshots[i].start = self.tally.steps;
+            self.open[d].push(i);
+        }
+        if let Some(c) = r.node {
+            self.last[d] = Some((c.value, c.chosen));
+            if let Some(k) = c.conflict {
