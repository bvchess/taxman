+                if self.checks.is_multiple_of(every) {
+                    let i = self.snapshot(state, (r.promoted, r.cands), &c.chosen, (c.value, r.need), c.computed, &k, None);
+                    self.open[d].push(i);
+                }
+            }
+        }
+        if let (Some((at, promoted, cands, k, x)), Some((value, chosen))) = (self.excluded.take(), self.last[d]) {
+            let i = self.snapshot(&at, (promoted, cands), &chosen, (value, r.need), false, &k, Some(x));
+            self.waiting[d].push(i);
+        }
+        if let StepEnd::LoopEnd(_) = r.end {
+            for i in self.open[d].drain(..).chain(self.waiting[d].drain(..)) {
+                self.snapshots[i].end = self.tally.steps;
+            }
+        }
+        if r.end == StepEnd::Child {
+            self.last[d + 1] = r.child.map(|c| (c.value, c.chosen));
+        }
+    }
