+/// The sets of the witness's exchanges (`--witness`): `nogood` with one member `w` of its witness (its members
+/// outside `conflict`) exchanged for a root candidate `y` outside it that touches a frame `w` touches and is `w`'s twin
+/// (`w = m·p`, `y = m·q`, `p` and `q` prime) or kin (`w = m·u`, `y = m·v`, `u` and `v` at most `KIN`), added to `out`.
+fn witness_exchanges<const W: usize>(
+    spf: &[u32],
+    model: &FrameGraph,
+    nogood: &Bits<W>,
+    conflict: &Bits<W>,
+    cands: &Bits<W>,
+    out: &mut Vec<Bits<W>>,
+) {
+    let top = cands.max().unwrap_or(0);
+    let frames = |x: u32| {
+        let (a, b) = model.frames_touched(x);
+        [Some(a), b]
+    };
+    for w in (*nogood - *conflict).iter() {
+        let near = frames(w);
+        let mut seen = Bits::<W>::EMPTY;
+        let mut push = |y: u32| {
+            if y == w || y > top || !cands.contains(y) || nogood.contains(y) || seen.contains(y) {
+                return;
+            }
+            seen.insert(y);
+            if frames(y).iter().flatten().any(|f| near.contains(&Some(*f))) {
+                out.push(nogood.without(w).with(y));
+            }
+        };
+        let mut rest = w;
+        while rest > 1 {
+            let p = spf[rest as usize];
+            while rest.is_multiple_of(p) {
+                rest /= p;
+            }
+            let m = w / p;
+            for q in (2..=top / m).filter(|&q| q != p && is_prime(q, spf)) {
+                push(m * q);
+            }
+        }
+        for u in (1..=KIN).filter(|&u| w.is_multiple_of(u)) {
+            for v in (1..=KIN).filter(|&v| v != u) {
+                push(w / u * v);
+            }
+        }
+    }
+}
