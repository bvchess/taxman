+    /// After [`propose`](Self::propose), with the tactic `nogoods`: the nogood `nogood` the searcher made of the
+    /// conflict `conflict` it computed at a node with the promotions `promoted`; more sets for it to learn nogoods
+    /// within, put in `more`.  Of each, a minimal conflict that a peel *from the root* finds within it is a nogood
+    /// (it holds at every node), and the searcher adds it to its table unless the table holds one within it, and then
+    /// tells the hook ([`learned_nogood`](Self::learned_nogood)).  A set that can be promoted from the root teaches
+    /// nothing, so this changes the tree, never the answer.  Asked only on the GF(2) path.
+    fn propose_nogoods(&mut self, promoted: &Bits<W>, conflict: &Bits<W>, nogood: &Bits<W>, more: &mut Vec<Bits<W>>) {
+        let _ = (promoted, conflict, nogood, more);
+    }
+
+    /// A nogood the searcher learned within a set that [`propose_nogoods`](Self::propose_nogoods) proposed.
+    fn learned_nogood(&mut self, set: &Bits<W>, nogood: &Bits<W>) {
+        let _ = (set, nogood);
+    }
