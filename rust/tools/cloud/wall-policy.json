{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EndTheRunByTakingTheGroupToCapacityZero",
      "Effect": "Allow",
      "Action": "autoscaling:SetDesiredCapacity",
      "Resource": "arn:aws:autoscaling:us-east-1:013764204840:autoScalingGroup:*:autoScalingGroupName/taxman-wall"
    },
    {
      "Sid": "ReadTheGroupToSeeThatItIsAtZero",
      "Effect": "Allow",
      "Action": "autoscaling:DescribeAutoScalingGroups",
      "Resource": "*"
    }
  ]
}
